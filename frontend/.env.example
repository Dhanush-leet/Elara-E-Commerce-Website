# ── ELARA environment ───────────────────────────────────────
# Copy to .env.local and fill in to enable real auth + email.
# Everything runs in demo mode without these.

# Auth.js — generate a secret with: npx auth secret  (or any random string)
AUTH_SECRET=

# Public site URL (used in emails + OAuth callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Google login ────────────────────────────────────────────
# Create at https://console.cloud.google.com → Credentials → OAuth client ID
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (pick ONE) ────────────────────────────────────────
# Option A — Resend (https://resend.com), simplest:
RESEND_API_KEY=

# Option B — Gmail SMTP. Use a Google "App Password" (not your login):
# https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# From address shown on outgoing mail
EMAIL_FROM=ELARA Maison <atelier@elara.maison>

# ── Payments (optional; checkout is demo-mode without these) ─
STRIPE_SECRET_KEY=
RAZORPAY_KEY_SECRET=
